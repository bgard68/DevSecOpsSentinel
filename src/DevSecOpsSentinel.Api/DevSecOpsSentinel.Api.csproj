<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DevSecOpsSentinel.Api</RootNamespace>
    <UserSecretsId>DevSecOpsSentinel-PhaseC-Local</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The integration test project already reaches into this assembly through
      `public partial class Program`. Exposing internals to that one assembly
      lets helpers stay internal rather than being made public purely so a test
      can see them.
    -->
    <InternalsVisibleTo Include="DevSecOpsSentinel.Api.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DevSecOpsSentinel.Application\DevSecOpsSentinel.Application.csproj" />
    <ProjectReference Include="..\DevSecOpsSentinel.Infrastructure\DevSecOpsSentinel.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Scenarios\**\*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
