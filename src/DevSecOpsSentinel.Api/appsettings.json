{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OpenAI": {
    "Mode": "Mock",
    "Model": "gpt-5-mini",
    "TimeoutSeconds": 30,
    "MaximumContextCharacters": 20000
  },
  "GitHub": {
    "Enabled": false,
    "ApiBaseUrl": "https://api.github.com",
    "AllowedRepositories": []
  },
  "Operational": {
    "CorrelationIdHeader": "X-Correlation-ID",
    "WorkflowRequestLimitPerMinute": 30
  }
}
