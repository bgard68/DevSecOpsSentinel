{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "OpenAI": {
    "Mode": "Mock",
    "Model": "gpt-5-mini",
    "TimeoutSeconds": 30,
    "MaximumContextCharacters": 20000
  },
  "GitHub": {
    "Enabled": false,
    "ApiBaseUrl": "https://api.github.com",
    "AllowedRepositories": [],
    "ResolveActionReferences": false
  },
  "Operational": {
    "CorrelationIdHeader": "X-Correlation-ID",
    "WorkflowRequestLimitPerMinute": 30
  },
  "Security": {
    "Mode": "Disabled",
    "HeaderName": "X-API-Key",
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://localhost:5173"
    ]
  }
}
