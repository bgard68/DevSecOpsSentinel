{
  "name": "devsecops-sentinel-web",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run verify:toolchain && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "npm run verify:toolchain && tsc -b --pretty false",
    "test": "node scripts/run-tests.mjs",
    "test:watch": "vitest",
    "verify:toolchain": "node scripts/verify-toolchain.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.1"
  }
}
