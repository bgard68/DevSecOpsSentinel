<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- ASP.NET Core packages stay aligned with the installed .NET 10 servicing line. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="11.0.0" />
    <!--
      Explicitly pins the transitive OpenAPI.NET dependency above the patched 2.x floor
      for GHSA-v5pm-xwqc-g5wc. No project directly references this package.
    -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.13.0" />
    <PackageVersion Include="Scalar.AspNetCore" Version="3.2.0" />
    <PackageVersion Include="OpenAI" Version="2.15.0" />
    <!--
      Structural workflow parsing. The rule engine keeps its own line model for
      content inside block scalars and for line-indexed patching; YamlDotNet
      supplies document structure and the line marks that go with it.
    -->
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <!--
      Reads the compiled assemblies so the layering tests assert what the
      compiler produced, not what the project files promise. Test-only; no
      shipped project may reference it.
    -->
    <PackageVersion Include="NetArchTest.eNhancedEdition" Version="1.4.5" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>
